/* Reset – minimal */
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.6;
}

/* =========================
   Navigation
   ========================= */

nav {
  border-bottom: 1px solid #e0e0e0;
}

.nav {
  display: flex;
  gap: 1.25rem;
  list-style: none;
  padding: 1rem;
  margin: 0;
  flex-wrap: wrap;
}

.nav li {
  margin: 0;
}

.nav a {
  text-decoration: none;
  color: inherit;
}

.nav a:hover {
  text-decoration: underline;
}

.nav a[aria-current="page"] {
  text-decoration: underline;
  font-weight: 600;
}

/* =========================
   Content-Grundlayout
   ========================= */

main {
  padding: 2rem 1rem;
  max-width: 720px;
}

header {
  padding: 2rem 1rem 1rem;
}

h1, h2 {
  line-height: 1.25;
}
